# Optional. Copy to .env to change a setting; every value below is already the default.
#
# These describe the host's view: Python run on the host reaches the containers on these
# addresses, and compose.yaml publishes its ports on them. Containers talk to each other by
# service name (mysql, mqtt) and ignore MYSQL_HOST / MQTT_HOST here.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=smart_iot
MYSQL_USER=smart_iot_user
MYSQL_PASSWORD=changeme

MQTT_HOST=127.0.0.1
MQTT_PORT=1883

API_PORT=8000
# TLS (docs/security/tls.md). Host ports: HTTPS dashboard (8080 only redirects to it) and MQTT over TLS.
HTTPS_PORT=8443
MQTTS_PORT=8883
# Names the generated server certificate is valid for (add your server's DNS name here).
TLS_HOSTNAMES=localhost,127.0.0.1,mqtt,dashboard,mysql
# Where the certificates live; put real ones here as server.crt / server.key.
TLS_DIR=./certs
# HSTS in seconds: 0 on localhost, 31536000 on a real domain.
HSTS_MAX_AGE=0
# production = the API refuses to start with the dev passwords below, a weak JWT_SECRET or without TLS.
APP_ENV=development

# Email (Phase 19): welcome emails for new accounts, password resets. Default: Mailpit, a local inbox at http://localhost:8025.
# For real mail: SMTP_HOST=smtp.example.com, SMTP_PORT=587, SMTP_STARTTLS=1, SMTP_USER=..., SMTP_PASSWORD=...
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=SmartIoT <no-reply@smartiot.local>
APP_BASE_URL=https://localhost:8443
MAILPIT_PORT=8025
# API authentication (docs/api/auth.md). The admin is created only while there are no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-dev-password
# Sign tokens with a fixed secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
# so sessions survive an API restart. Empty = random per start.
JWT_SECRET=
TOKEN_MINUTES=60

# Broker accounts (docs/security/security.md). QA is the test-harness account: leave it empty outside dev.
SENSOR_MQTT_PASSWORD=sensor-dev-password
RECEIVER_MQTT_PASSWORD=receiver-dev-password
API_MQTT_PASSWORD=api-dev-password
QA_MQTT_PASSWORD=qa-dev-password
DASHBOARD_PORT=8080

# Simulator (Docker default 5 sensors; run on the host it defaults to 1)
SENSOR_INTERVAL=5
SENSOR_COUNT=5

# Receiver: mark a sensor OFFLINE after this many seconds without a reading (see docs/architecture/alerts.md)
OFFLINE_TIMEOUT=30
OFFLINE_CHECK_INTERVAL=5
# Most messages one database transaction stores when they queue up under load
RECEIVER_BATCH_MAX=200
# Receiver: a command with no answer after this many seconds becomes TIMED_OUT (docs/architecture/commands.md)
COMMAND_TIMEOUT=30
# FOTA (docs/architecture/fota.md): receiver timeout, and a failure injected into every update by the simulator
FOTA_TIMEOUT=300
FOTA_FAILURE=none
# Simulator fault injection, probability per reading 0-1 (docs/testing/reliability.md)
FAULT_INVALID_RATE=0
FAULT_MALFORMED_RATE=0
FAULT_DUPLICATE_RATE=0
