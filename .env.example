# Inside Docker Compose: mysql / 3306. Python run on the host: localhost / 3307
# (docker/docker-compose.yml publishes MySQL on host port 3307).
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=smart_iot
MYSQL_USER=smart_iot_user
MYSQL_PASSWORD=changeme

MQTT_HOST=mqtt
MQTT_PORT=1883

API_PORT=8000
SENSOR_INTERVAL=5
SENSOR_COUNT=1

# Receiver: mark a sensor OFFLINE after this many seconds without a reading (see docs/architecture/alerts.md)
OFFLINE_TIMEOUT=30
OFFLINE_CHECK_INTERVAL=5
